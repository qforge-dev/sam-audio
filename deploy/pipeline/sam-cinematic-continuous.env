SAM_CONTINUOUS_WORKSPACE=/home/ubuntu/cinematic-continuous-30s
SAM_CONTINUOUS_STAGED_ACQUISITION=true
SAM_CONTINUOUS_S3_BUCKET=sam-audio-pipeline-artifactbucket-ndb3jfc3asyk
SAM_CONTINUOUS_S3_PREFIX=cinematic-dialogue-dataset
SAM_CONTINUOUS_SEARCH_WORKERS=8
SAM_CONTINUOUS_DOWNLOAD_WORKERS=32
SAM_CONTINUOUS_M2D_WORKERS=1
SAM_CONTINUOUS_ASR_WORKERS=1
SAM_CONTINUOUS_UPLOAD_CONCURRENCY=10
SAM_CONTINUOUS_AUTOSCALE_ENABLED=true
SAM_CONTINUOUS_DOWNLOAD_MIN=2
SAM_CONTINUOUS_ASR_CONCURRENCY_MIN=4
SAM_CONTINUOUS_ASR_CONCURRENCY_MAX=8
SAM_CONTINUOUS_ASR_CPU_THREADS=4
SAM_CONTINUOUS_CPU_LOW=55
SAM_CONTINUOUS_CPU_HIGH=85
SAM_CONTINUOUS_CPU_EMERGENCY=95
SAM_CONTINUOUS_M2D_BACKLOG_HIGH=64
SAM_CONTINUOUS_ASR_BACKLOG_HIGH=8
SAM_CONTINUOUS_GPU_RESERVE_MB=8000
SAM_CONTINUOUS_AUTOSCALE_COOLDOWN_SECONDS=20
SAM_CONTINUOUS_AUTOSCALE_INTERVAL_SECONDS=10
SAM_CONTINUOUS_BASE_CLIPS_PER_VIDEO=16
SAM_CONTINUOUS_SOURCE_CONTENT_MINUTES_PER_HOUR=10
SAM_CONTINUOUS_MAX_DURATION_SCALED_CLIPS_PER_VIDEO=60
SAM_CONTINUOUS_SOURCE_SCAN_ENABLED=true
SAM_CONTINUOUS_SOURCE_SCAN_BATCH_SIZE=128
SAM_CONTINUOUS_SOURCE_SCAN_INFERENCE_CONCURRENCY=8
SAM_CONTINUOUS_SOURCE_SCAN_TARGET_WINDOWS=3600
SAM_CONTINUOUS_SOURCE_SCAN_MAX_WINDOW_HOP_SECONDS=5
SAM_CONTINUOUS_SOURCE_SCAN_LONG_INFERENCE_CONCURRENCY=2
SAM_CONTINUOUS_DISCOVERY_SOURCES=bilibili,dailymotion,vimeo,youtube
SAM_CONTINUOUS_DISCOVERED_HIGH_WATER=5000
SAM_CONTINUOUS_PLATFORM_DISCOVERED_HIGH_WATER=10000
# Keep an unavailable opportunistic provider from occupying the reliable-source
# frontier. Terminal history does not count toward these active-source limits.
SAM_CONTINUOUS_PLATFORM_DISCOVERED_HIGH_WATERS=dailymotion=2500,vimeo=2500,bilibili=2000,youtube=100
SAM_CONTINUOUS_DISCOVERY_MINIMUM_CANDIDATES=1
SAM_CONTINUOUS_DISCOVERY_QUERY_COUNT=25
SAM_CONTINUOUS_DISCOVERY_PROVIDER_QUERY_COUNTS=dailymotion=25,vimeo=10,bilibili=15,youtube=2
SAM_CONTINUOUS_DISCOVERY_SUCCESS_PAUSE_SECONDS=5
SAM_CONTINUOUS_DISCOVERY_FAILURE_PAUSE_SECONDS=30
SAM_CONTINUOUS_DISCOVERY_HIGH_WATER_PAUSE_SECONDS=30
SAM_CONTINUOUS_DISCOVERY_EMPTY_MAX_PAUSE_SECONDS=300
# Keep every provider represented, but bias native discovery toward Bilibili:
# its recent batches still yield unseen sources while Dailymotion and Vimeo
# mostly traverse exhausted pages. The acceptance monitor can suspend any weak
# Bilibili query family independently of this provider-level allocation.
SAM_CONTINUOUS_DISCOVERY_PROCESSES=11
SAM_CONTINUOUS_DISCOVERY_PROVIDER_WORKERS=dailymotion=8,vimeo=16,bilibili=4,youtube=1
SAM_PAID_SEARCH_ENABLED=true
# If paid search is deliberately re-enabled, the cross-process budget limits
# the maximum spend to 200 requests/day (about $1/day at Brave's current rate).
SAM_PAID_SEARCH_DAILY_REQUEST_LIMIT=200
SAM_CONTINUOUS_SOURCE_DOWNLOAD_WORKERS=240
SAM_CONTINUOUS_SOURCE_DOWNLOAD_INDEPENDENT=true
SAM_CONTINUOUS_SOURCE_DOWNLOAD_MAX_ATTEMPTS=12
SAM_CONTINUOUS_SOURCE_DOWNLOAD_RETRY_BACKOFF_SECONDS=2
SAM_CONTINUOUS_SOURCE_STAGING_DIR=/home/ubuntu/cinematic-continuous-30s/source-work/.staging
# Optional distributed media execution. The coordinator and worker must expose
# the source workspace at identical absolute paths (for example through a
# private NFS mount). Tasks left out of this list always execute locally.
SAM_MEDIA_WORKER_SSH_TARGET=ubuntu@172.31.75.253
SAM_MEDIA_WORKER_SSH_IDENTITY=/home/ubuntu/.ssh/sam-media-worker
SAM_MEDIA_WORKER_REMOTE_TASKS=download,ffmpeg,extract
# Download commands use bounded direct SSH execution so high fan-out transfers
# do not create hundreds of transient systemd units on the media host.
SAM_MEDIA_WORKER_DIRECT_TASKS=download
SAM_MEDIA_WORKER_SHARED_TMP=/home/ubuntu/cinematic-continuous-30s/source-work/.staging
SAM_CONTINUOUS_DOWNLOADED_HIGH_WATER=1000000
SAM_CONTINUOUS_DOWNLOADED_HIGH_WATER_BYTES=10995116277760
SAM_CONTINUOUS_DOWNLOAD_MINIMUM_FREE_BYTES=214748364800
SAM_CONTINUOUS_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=64
SAM_CONTINUOUS_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
SAM_CONTINUOUS_PROVIDER_CIRCUIT_MAX_COOLDOWN_SECONDS=600
SAM_CONTINUOUS_SOURCE_PROVIDER_WEIGHTS=dailymotion=6,bilibili=2,vimeo=6,youtube=1
# YouTube is opportunistic. It may use at most 8/240 transfer slots, and four
# consecutive transport failures open its provider circuit without affecting
# the three reliable providers.
SAM_CONTINUOUS_SOURCE_PROVIDER_MAX_ACTIVE=youtube=8
SAM_CONTINUOUS_SOURCE_PROVIDER_MIN_CLAIM_INTERVAL_SECONDS=youtube=1
SAM_CONTINUOUS_PROVIDER_CIRCUIT_FAILURE_THRESHOLDS=youtube=4
SAM_YTDLP_PROXY_SLOTS=240
SAM_YTDLP_CONCURRENT_FRAGMENTS=4
# Route every provider through the protected Webshare pool. Dailymotion direct
# repeatedly timed out on this host, so it is no longer exempt from proxying.
SAM_YTDLP_DIRECT_PLATFORMS=
SAM_CONTINUOUS_SOURCE_SCAN_WORKERS=24
SAM_CONTINUOUS_SOURCE_SCAN_CPU_EXEMPT=true
SAM_CONTINUOUS_SCANNED_HIGH_WATER=64
SAM_CONTINUOUS_SOURCE_EXTRACT_WORKERS=16
SAM_CONTINUOUS_SOURCE_ASR_PROBE_MODE=enforce
SAM_CONTINUOUS_SOURCE_ASR_SHARED_ROOT=/home/ubuntu/cinematic-continuous-30s/source-work/.source-asr
SAM_CONTINUOUS_ASR_MODEL=/home/ubuntu/.cache/huggingface/faster-whisper/models--Systran--faster-whisper-small/snapshots/536b0662742c02347bc0e980a01041f333bce120
SAM_CONTINUOUS_ASR_MODEL_LABEL=small
SAM_CONTINUOUS_ASR_DEVICE=cuda
SAM_CONTINUOUS_ASR_COMPUTE_TYPE=float16
SAM_CONTINUOUS_ASR_CUDA_LIBRARY_PATH=/home/ubuntu/whisper-venv/lib/python3.12/site-packages/nvidia/cublas/lib:/home/ubuntu/whisper-venv/lib/python3.12/site-packages/nvidia/cudnn/lib
SAM_CONTINUOUS_SOURCE_ASR_CPU_WORKERS=12
SAM_CONTINUOUS_SOURCE_ASR_CPU_THREADS=3
SAM_CONTINUOUS_SOURCE_ASR_CPU_FINAL_ENABLED=false
SAM_CONTINUOUS_EXTERNAL_ASR=false
SAM_YOUTUBE_PROXY_CONFIG=/home/ubuntu/.config/sam-audio/proxy-pool
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
