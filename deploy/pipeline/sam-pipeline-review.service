[Unit]
Description=SAM Audio collaborative dataset review app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-audio-review.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/start-review.sh
Restart=on-failure
RestartSec=5

# The service writes only the annotation JSON and reads the dataset/audio.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
