[Unit]
Description=SAM Audio single-consumer GPU queue worker
After=network-online.target sam-audio-api.service
Wants=network-online.target sam-audio-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/start-pipeline.sh sam-pipeline-worker --role sam
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

