[Unit]
Description=Adaptive concurrency controller for independent source stages
After=sam-source-download.service sam-source-scan.service sam-source-extract.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-cinematic-continuous.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/run-source-autoscale.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
