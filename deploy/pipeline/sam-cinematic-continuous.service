[Unit]
Description=Continuous 30-second cinematic dataset producer/consumer pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-cinematic-continuous.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/run-continuous-cinematic-dataset.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
