AFNEXT_MODEL=/home/ubuntu/models/audio-flamingo-next-captioner-hf
AFNEXT_MAX_NEW_TOKENS=384
AFNEXT_GENERATION_HARD_LIMIT=384
AFNEXT_MAX_BATCH_SIZE=16
# S3 fetch/audio preparation introduces enough request jitter to fragment a
# backfill wave. Coalesce briefly so the dedicated revision GPU receives a full
# batch while retaining measured H100 memory headroom for sixteen 30-second stems.
AFNEXT_BATCH_WAIT_MS=2000
AFNEXT_HOST=127.0.0.1
AFNEXT_PORT=8003
CUDA_VISIBLE_DEVICES=0
HF_HOME=/home/ubuntu/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
