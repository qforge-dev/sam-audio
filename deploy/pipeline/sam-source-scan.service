[Unit]
Description=Resident whole-source M2D scanner
After=network-online.target sam-source-download.service sam-cinematic-continuous.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-cinematic-continuous.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/run-source-scan.sh
ExecStopPost=/home/ubuntu/sam-audio-deploy/pipeline/.venv/bin/python -m sam_audio_pipeline.remote_media cleanup ffmpeg
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
