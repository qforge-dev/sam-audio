[Unit]
Description=Reconcile durable SAM Audio pipeline state with queues
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-audio-pipeline.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/start-pipeline.sh sam-pipeline-worker --role reconcile
