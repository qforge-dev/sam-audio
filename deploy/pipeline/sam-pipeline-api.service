[Unit]
Description=SAM Audio pipeline API and review panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/start-pipeline.sh sam-pipeline-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

