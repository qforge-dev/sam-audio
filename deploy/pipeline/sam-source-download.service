[Unit]
Description=Persistent cinematic source transfer pool
After=network-online.target sam-source-discovery.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sam-audio-deploy/pipeline
EnvironmentFile=/etc/sam-cinematic-continuous.env
ExecStart=/home/ubuntu/sam-audio-deploy/deploy/pipeline/run-source-download.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
